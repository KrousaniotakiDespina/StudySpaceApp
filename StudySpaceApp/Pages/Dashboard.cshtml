@page "/dashboard"
@model StudySpaceApp.Pages.DashboardModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>StudySpace - Dashboard</title>

    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link href="https://fonts.googleapis.com/css2?family=Aladin&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inconsolata:wght@400;500;600&display=swap" rel="stylesheet">
</head>

<body>
    <div class="dashboard-page">

        <button type="button"
                class="mobile-menu-btn"
                id="mobile-menu-btn"
                aria-label="Open menu">
            ☰
        </button>

        <aside class="sidebar" id="sidebar">

            <h1>StudySpace</h1>

            <div class="dashboard-link">

                <img src="~/images/icons/home.svg"
                     alt="Dashboard"
                     class="sidebar-icon" />
                <span>Dashboard</span>

            </div>

            <div class="sidebar-bottom">
                <div class="theme-section">

                    <div class="theme-heading">

                        <img src="~/images/icons/palette.svg"
                             alt="Theme"
                             class="sidebar-icon" />
                        <span>Theme</span>

                    </div>

                    <div class="theme-colors">

                        <button class="theme-circle pink"
                                type="button"
                                data-theme="pink">
                        </button>

                        <button class="theme-circle blue"
                                type="button"
                                data-theme="blue">
                        </button>

                        <button class="theme-circle green"
                                type="button"
                                data-theme="green">
                        </button>

                        <button class="theme-circle gray"
                                type="button"
                                data-theme="gray">
                        </button>

                    </div>
                </div>

                <form method="post"
                      asp-page-handler="Logout">

                    <button class="logout-button"
                            type="submit">

                        <img src="~/images/icons/logout.svg"
                             alt="Log out"
                             class="sidebar-icon" />

                        <span>Log out</span>

                    </button>

                </form>

            </div>

        </aside>

        <main class="main-content">

            <div class="user-header">
                <img src="~/images/icons/avatar.svg"
                     alt="User"
                     class="avatar-image" />
                <span>@Model.Firstname</span>
            </div>

            <div class="top-row">

                <section class="dashboard-card calendar-card">

                    <div class="calendar-title">

                        <div class="calendar-heading">
                            <img src="~/images/icons/calendar.svg" alt="Calendar" class="calendar-icon" />
                            <h2>Calendar</h2>
                        </div>

                        <div class="calendar-month">

                            <button type="button" class="calendar-arrow" id="previous-month">
                                ←
                            </button>

                            <span id="calendar-month-title"></span>

                            <button type="button" class="calendar-arrow" id="next-month">
                                →
                            </button>

                        </div>

                    </div>

                    <div class="calendar-grid"
                         id="calendar-grid">
                    </div>

                </section>

                <section class="dashboard-card todo-card">

                    <div class="card-title-row">

                        <div class="todo-heading">
                            <img src="~/images/icons/todo.svg"
                                 alt="To-do List"
                                 class="todo-icon" />

                            <h2>To-do-List</h2>
                        </div>

                        <button type="button"
                                class="small-button"
                                id="add-task-button">
                            + Add task
                        </button>

                    </div>

                    <div class="todo-list">

                        @foreach (var task in Model.TodoTasks)
                        {
                            <div class="todo-item">

                                <form method="post"
                                      asp-page-handler="UpdateTaskCompleted"
                                      class="update-task-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@task.Id" />

                                    <input type="checkbox"
                                           name="isCompleted"
                                           value="true"
                                           checked="@task.IsCompleted"
                                           class="task-checkbox" />

                                    <input type="hidden"
                                           name="isCompleted"
                                           value="false" />

                                </form>

                                <span>@task.Title</span>

                                <form method="post"
                                      asp-page-handler="DeleteTask"
                                      class="delete-task-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@task.Id" />

                                    <button type="button"
                                            class="delete-task-button">
                                        ×
                                    </button>

                                </form>

                            </div>
                        }

                    </div>

                </section>

            </div>

            <div class="bottom-row">

                <section class="dashboard-card notes-card">

                    <div class="card-title-row">

                        <div class="notes-heading">
                            <img src="~/images/icons/notes.svg"
                                 alt="Notes"
                                 class="notes-icon" />

                            <h2>Notes</h2>
                        </div>

                        <button type="button"
                                class="small-button"
                                id="new-note-button">
                            + New Note
                        </button>

                    </div>

                    <div class="notes-list">

                        @foreach (var note in Model.Notes)
                        {
                            <div class="note-item">

                                <span>
                                    @note.Content
                                </span>

                                <form method="post"
                                      asp-page-handler="DeleteNote"
                                      class="delete-note-form">

                                    <input type="hidden"
                                           name="id"
                                           value="@note.Id" />

                                    <button type="button"
                                            class="delete-note-button">
                                        ×
                                    </button>

                                </form>

                            </div>
                        }

                    </div>

                </section>

                <section class="dashboard-card timer-card">

                    <div class="timer-heading">
                        <img src="~/images/icons/timer.svg"
                             alt="Timer"
                             class="timer-icon" />

                        <h2>Timer</h2>
                    </div>

                    <div class="timer-content">

                        <div class="timer-circle">

                            <span class="timer-label" id="timer-label">
                                Focus
                            </span>

                            <span class="timer-time" id="timer-time">
                                25 : 00
                            </span>

                        </div>

                        <div class="timer-controls">

                            <button type="button" class="reset-button">
                                <img src="~/images/icons/restart.svg"
                                     alt="Restart"
                                     class="restart-icon" />
                            </button>

                            <button type="button" class="play-button">
                                <img src="~/images/icons/play.svg"
                                     alt="Play"
                                     class="play-icon" />
                            </button>

                        </div>

                    </div>

                </section>

                <section class="dashboard-card music-card">

                    <div class="music-heading">
                        <img src="~/images/icons/music.svg"
                             alt="Music"
                             class="music-icon" />

                        <h2>Music</h2>
                    </div>

                    <div class="music-list">

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/forest.wav">
                            <span class="music-emoji">🌲</span>
                            <span class="music-name">Forest</span>
                        </button>

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/rain.wav">
                            <span class="music-emoji">🌧️</span>
                            <span class="music-name">Rain</span>
                        </button>

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/waves.wav">
                            <span class="music-emoji">🌊</span>
                            <span class="music-name">Waves</span>
                        </button>

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/fireplace.wav">
                            <span class="music-emoji">🔥</span>
                            <span class="music-name">Fireplace</span>
                        </button>

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/jazz.mp3">
                            <span class="music-emoji">🎷</span>
                            <span class="music-name">Jazz</span>
                        </button>

                        <button type="button"
                                class="music-button"
                                data-audio="/audio/chill.mp3">
                            <span class="music-emoji">🎵</span>
                            <span class="music-name">Chill Beats</span>
                        </button>

                    </div>

                    <div class="now-playing">

                        <button type="button"
                                id="now-playing-button"
                                class="now-playing-button">

                            <img src="~/images/icons/play.svg"
                                 alt="Play"
                                 id="now-playing-icon" />

                        </button>

                        <div class="now-playing-info">
                            <span id="current-track">Select music</span>
                            <small id="playing-status">Not playing</small>
                        </div>

                    </div>

                    <audio id="music-player" loop></audio>

                </section>

            </div>

        </main>

    </div>

    <audio id="bell-sound" src="/audio/bell.mp3"></audio>

    <form method="post"
          asp-page-handler="AddTask"
          id="task-form">

        <div class="input-modal" id="input-modal">

            <div class="input-modal-box">

                <h3 id="modal-title">Add</h3>

                <textarea id="modal-input"
                          placeholder="Write here...">
                </textarea>

                <input type="hidden"
                       id="task-title-input"
                       name="NewTaskTitle" />

                <input type="hidden"
                       id="note-content-input"
                       name="NewNoteContent" />

                <div class="modal-buttons">

                    <button type="button"
                            id="modal-cancel">
                        Cancel
                    </button>

                    <button type="button"
                            id="modal-save">
                        Add
                    </button>

                </div>

            </div>

        </div>

    </form>

    <!-- MUSIC -->

    <script>

            const musicButtons = document.querySelectorAll(".music-button");

            const musicPlayer = document.getElementById("music-player");

            const nowPlayingButton =
                document.getElementById("now-playing-button");

            const nowPlayingIcon =
                document.getElementById("now-playing-icon");

            const currentTrack =
                document.getElementById("current-track");

            const playingStatus =
                document.getElementById("playing-status");


            musicButtons.forEach(button => {

                button.addEventListener("click", () => {

                    const audioFile =
                        button.getAttribute("data-audio");

                    const trackName =
                        button.textContent.trim();

                    musicPlayer.src = audioFile;

                    musicPlayer.play();

                    nowPlayingIcon.src = "/images/icons/pause.svg";

                    currentTrack.textContent = trackName;

                    playingStatus.textContent = "Now playing";

                });

            });

            nowPlayingButton.addEventListener("click", () => {

                if (!musicPlayer.src) {
                    return;
                }

                if (musicPlayer.paused) {

                    musicPlayer.play();

                    playingStatus.textContent = "Now playing";

                    nowPlayingIcon.src = "/images/icons/pause.svg";

                }
                else {

                    musicPlayer.pause();

                    playingStatus.textContent = "Paused";

                    nowPlayingIcon.src = "/images/icons/play.svg";

                }

            });

    </script>

    <!-- TIMER -->

    <script>

            const timerDisplay = document.getElementById("timer-time");
            const timerLabel = document.getElementById("timer-label");
            const timerCircle = document.querySelector(".timer-circle");

            const playButton = document.querySelector(".play-button");
            const restartButton = document.querySelector(".reset-button");

            const bellSound = document.getElementById("bell-sound");

            const timerPlayIcon = playButton.querySelector("img");

            const focusTime = 25 * 60;
            const breakTime = 5 * 60;

            let totalSeconds = focusTime;

            let isFocus = true;
            let isRunning = false;

            let timerInterval = null;

            function updateTimerDisplay() {

                const minutes = Math.floor(totalSeconds / 60);
                const seconds = totalSeconds % 60;


                timerDisplay.textContent = `${String(minutes).padStart(2, "0")} : ${String(seconds).padStart(2, "0")}`;

                const currentDuration = isFocus ? focusTime : breakTime;

                const progress = (totalSeconds / currentDuration) * 100;

                timerCircle.style.setProperty(
                    "--progress",
                    progress + "%"
                );

            }

            function changePomodoroMode() {

                bellSound.currentTime = 0;

                bellSound.play();

                if (isFocus) {

                    isFocus = false;

                    totalSeconds = breakTime;

                    timerLabel.textContent = "Break";

                }
                else {

                    isFocus = true;

                    totalSeconds = focusTime;

                    timerLabel.textContent = "Focus";
                }

                updateTimerDisplay();
            }

            playButton.addEventListener("click", () => {

                if (isRunning) {

                    clearInterval(timerInterval);

                    isRunning = false;

                    timerPlayIcon.src = "/images/icons/play.svg";

                    return;
                }

                isRunning = true;

                timerPlayIcon.src = "/images/icons/pause.svg";

                timerInterval = setInterval(() => {

                    if (totalSeconds > 0) {

                        totalSeconds--;

                        updateTimerDisplay();

                    }
                    else {

                        changePomodoroMode();

                    }

                }, 1000);

            });

            restartButton.addEventListener("click", () => {

                clearInterval(timerInterval);

                isFocus = true;

                totalSeconds = focusTime;

                isRunning = false;

                timerLabel.textContent = "Focus";

                timerPlayIcon.src = "/images/icons/play.svg";

                updateTimerDisplay();

            });

            updateTimerDisplay();

    </script>

    <!-- CALENDAR -->

    <script>

            const calendarGrid =
                document.getElementById("calendar-grid");

            const calendarMonthTitle =
                document.getElementById("calendar-month-title");

            const previousMonthButton =
                document.getElementById("previous-month");

            const nextMonthButton =
                document.getElementById("next-month");

            const today = new Date();

            let currentMonth = today.getMonth();
            let currentYear = today.getFullYear();

            const monthNames = [
                "January",
                "February",
                "March",
                "April",
                "May",
                "June",
                "July",
                "August",
                "September",
                "October",
                "November",
                "December"
            ];

            function renderCalendar() {

                calendarGrid.innerHTML = "";

                calendarMonthTitle.textContent =
                    `${monthNames[currentMonth]} ${currentYear}`;


                const firstDay =
                    new Date(currentYear, currentMonth, 1).getDay();

                const mondayFirstDay =
                    (firstDay + 6) % 7;

                const daysInMonth =
                    new Date(currentYear, currentMonth + 1, 0).getDate();

                for (let i = 0; i < mondayFirstDay; i++) {

                    const emptyCell =
                        document.createElement("div");

                    emptyCell.classList.add(
                        "calendar-cell",
                        "empty"
                    );

                    calendarGrid.appendChild(emptyCell);
                }

                for (let day = 1; day <= daysInMonth; day++) {

                    const calendarCell =
                        document.createElement("div");

                    calendarCell.classList.add("calendar-cell");

                    const dayNumber =
                        document.createElement("span");

                    dayNumber.classList.add("day-number");

                    dayNumber.textContent = day;

                    if (
                        day === today.getDate() &&
                        currentMonth === today.getMonth() &&
                        currentYear === today.getFullYear()
                    ) {
                        dayNumber.classList.add("selected-day");
                    }

                    calendarCell.appendChild(dayNumber);

                    calendarGrid.appendChild(calendarCell);
                }

            }

            previousMonthButton.addEventListener("click", () => {

                currentMonth--;

                if (currentMonth < 0) {

                    currentMonth = 11;

                    currentYear--;
                }

                renderCalendar();

            });

            nextMonthButton.addEventListener("click", () => {

                currentMonth++;
             
                if (currentMonth > 11) {

                    currentMonth = 0;

                    currentYear++;
                }

                renderCalendar();

            });

            renderCalendar();

    </script>

    <!-- THEMES -->

    <script>

            const themeButtons =
                document.querySelectorAll(".theme-circle");

            const dashboardPage =
                document.querySelector(".dashboard-page");

            const savedTheme =
                localStorage.getItem("selectedTheme");

            if (savedTheme && savedTheme !== "blue") {

                dashboardPage.classList.add(
                    savedTheme + "-theme"
                );

            }

            themeButtons.forEach(button => {

                button.addEventListener("click", () => {

                    const selectedTheme =
                        button.getAttribute("data-theme");

                    dashboardPage.classList.remove(
                        "pink-theme",
                        "green-theme",
                        "gray-theme"
                    );

                    if (selectedTheme !== "blue") {

                        dashboardPage.classList.add(
                            selectedTheme + "-theme"
                        );

                    }

                    localStorage.setItem(
                        "selectedTheme",
                        selectedTheme
                    );

                });

            });

    </script>

    <!-- ADD TASK / NOTE MODAL -->

    <script>

            const newNoteButton =
                document.getElementById("new-note-button");

            const addTaskButton =
                document.getElementById("add-task-button");

            const taskTitleInput =
                document.getElementById("task-title-input");

            const inputModal =
                document.getElementById("input-modal");

            const modalTitle =
                document.getElementById("modal-title");

            const modalInput =
                document.getElementById("modal-input");

            const modalCancel =
                document.getElementById("modal-cancel");

            const modalSave =
                document.getElementById("modal-save");

            const notesList =
                document.querySelector(".notes-list");

            const noteContentInput =
                document.getElementById("note-content-input");

            const todoList =
                document.querySelector(".todo-list");

            const taskForm =
                document.getElementById("task-form");

            let currentType = "";

            newNoteButton.addEventListener("click", () => {

                currentType = "note";

                modalTitle.textContent = "New Note";

                modalInput.placeholder = "Write your note...";

                modalInput.value = "";

                inputModal.classList.add("show");

                modalInput.focus();

            });

            addTaskButton.addEventListener("click", () => {

                currentType = "task";

                modalTitle.textContent = "Add Task";

                modalInput.placeholder = "Write your task...";

                modalInput.value = "";

                inputModal.classList.add("show");

                modalInput.focus();

            });

            modalCancel.addEventListener("click", () => {

                inputModal.classList.remove("show");

                modalInput.value = "";

            });

            modalSave.addEventListener("click", async () => {

                const text =
                    modalInput.value.trim();

                if (!text) {
                    return;
                }

                const formData =
                    new FormData(taskForm);

                if (currentType === "note") {

                    formData.set(
                        "NewNoteContent",
                        text
                    );

                    const response =
                        await fetch("?handler=AddNote", {
                            method: "POST",
                            body: formData
                        });

                    if (response.ok) {

                        const newNote =
                            await response.json();

                        const noteItem =
                            document.createElement("div");

                        noteItem.classList.add("note-item");

                        noteItem.innerHTML = `
                            <span>${newNote.content}</span>

                            <form method="post"
                                  action="?handler=DeleteNote"
                                  class="delete-note-form">

                                <input type="hidden"
                                       name="id"
                                       value="${newNote.id}" />

                                <button type="button"
                                        class="delete-note-button">
                                    ×
                                </button>

                            </form>
                        `;

                        notesList.prepend(noteItem);

                        inputModal.classList.remove("show");
                        modalInput.value = "";
                    }

                    return;
                }

                if (currentType === "task") {

                    formData.set(
                        "NewTaskTitle",
                        text
                    );

                    const response =
                        await fetch("?handler=AddTask", {
                            method: "POST",
                            body: formData
                        });

                    if (response.ok) {

                        const newTask =
                            await response.json();

                        const taskItem =
                            document.createElement("div");

                        taskItem.classList.add("todo-item");

                        taskItem.innerHTML = `
                            <form method="post"
                                  action="?handler=UpdateTaskCompleted"
                                  class="update-task-form">

                                <input type="hidden"
                                       name="id"
                                       value="${newTask.id}" />

                                <input type="checkbox"
                                       name="isCompleted"
                                       value="true"
                                       class="task-checkbox" />

                                <input type="hidden"
                                       name="isCompleted"
                                       value="false" />

                            </form>

                            <span>${newTask.title}</span>

                            <form method="post"
                                  action="?handler=DeleteTask"
                                  class="delete-task-form">

                                <input type="hidden"
                                       name="id"
                                       value="${newTask.id}" />

                                <button type="button"
                                        class="delete-task-button">
                                    ×
                                </button>

                            </form>
                        `;

                        todoList.prepend(taskItem);

                        inputModal.classList.remove("show");
                        modalInput.value = "";
                    }

                    return;
                }

            });

    </script>

    <!-- Delete Task / Note -->

    <script>

            document.addEventListener("click", async (event) => {

                const deleteTaskButton =
                    event.target.closest(".delete-task-button");

                if (deleteTaskButton) {

                    const form =
                        deleteTaskButton.closest(".delete-task-form");

                    const formData =
                        new FormData(form);

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    formData.set(
                        "__RequestVerificationToken",
                        token
                    );

                    const response =
                        await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                    const result =
                        await response.json();

                    if (result.success) {
                        form.closest(".todo-item").remove();
                    }

                    return;
                }


                const deleteNoteButton =
                    event.target.closest(".delete-note-button");

                if (deleteNoteButton) {

                    const form =
                        deleteNoteButton.closest(".delete-note-form");

                    const formData =
                        new FormData(form);

                    const token =
                        document.querySelector(
                            'input[name="__RequestVerificationToken"]'
                        ).value;

                    formData.set(
                        "__RequestVerificationToken",
                        token
                    );

                    const response =
                        await fetch(form.action, {
                            method: "POST",
                            body: formData
                        });

                    const result =
                        await response.json();

                    if (result.success) {
                        form.closest(".note-item").remove();
                    }
                }

            });

    </script>

    <!-- UPDATE TASK COMPLETED -->

    <script>

            document.addEventListener("change", async (event) => {

                if (!event.target.classList.contains("task-checkbox")) {
                    return;
                }

                const checkbox = event.target;

                const form =
                    checkbox.closest(".update-task-form");

                const formData =
                    new FormData(form);

                formData.set(
                    "isCompleted",
                    checkbox.checked
                );

                const token =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    ).value;

                formData.set(
                    "__RequestVerificationToken",
                    token
                );

                const response =
                    await fetch(form.action, {
                        method: "POST",
                        body: formData
                    });

                if (!response.ok) {
                    console.error("Task completion update failed.");
                }

            });

    </script>

    <!-- MOBILE SIDEBAR -->

    <script>
            const mobileMenuBtn =
                document.getElementById("mobile-menu-btn");

            const sidebar =
                document.getElementById("sidebar");

            mobileMenuBtn.addEventListener("click", () => {
                sidebar.classList.toggle("open");
            });
    </script>

</body>

</html>