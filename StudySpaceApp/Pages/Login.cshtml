@page "/"
@model StudySpaceApp.Pages.LoginModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>StudySpace - Login</title>

    <link rel="stylesheet" href="~/css/login.css" />
    <link href="https://fonts.googleapis.com/css2?family=Aladin&display=swap" rel="stylesheet">
</head>

<body>
    <div class="login-page">

        <div class="login-card">

            <h1>StudySpace</h1>

            <h2>Welcome Back</h2>

            <p>Sign in to continue to StudySpace</p>

            <form method="post">

                <div class="input-box">

                    <img src="/images/icons/email.svg"
                         alt="Email" />

                    <input asp-for="LoginDTO.Email"
                           type="email"
                           placeholder="Email address" />

                </div>

                <div class="input-box">

                    <img src="/images/icons/lock.svg"
                         alt="Password" />

                    <input asp-for="LoginDTO.Password"
                           type="password"
                           placeholder="Password" />

                </div>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <p class="login-error">
                        @Model.ErrorMessage
                    </p>
                }

                <button type="submit">
                    Log In
                </button>

            </form>

        </div>

    </div>
</body>
</html>